169 - .PKGINFO
name = netfs
version = 1.0.1-1
desc = shared folders: use another computer's directories over the network
depend = byteos>=1.12.1
backup = /etc/netfs.conf
isize = 13570
362 - .INSTALL
function post_install()
  local systemd = require("systemd")
  systemd.enable("netfsd")
  systemd.start("netfsd")
  print("netfsd is running; share folders in /etc/netfs.conf")
end
function post_upgrade() require("systemd").restart("netfsd") end
function pre_remove()
  local systemd = require("systemd")
  systemd.stop("netfsd")
  systemd.disable("netfsd")
end
339 - /etc/netfs.conf
# Folders this computer shares with the network (netfsd reads this file
# for every request, so changes count at once). One share per line:
#
#   <name>  <directory>  ro|rw
#
# ro: others may only read; rw: they may also write and delete.
# Anyone on the network can use a share, so share nothing secret.
#
# public  /home/root/public  ro
2448 z /usr/bin/netfs.lua
 z /usr/bin/netfsd.lua
 z /usr/lib/netfs.lua
 - /usr/lib/systemd/system/netfsd.service
[Unit]
Description=Shared Folders Server

[Service]
ExecStart=netfsd
Restart=on-failure
