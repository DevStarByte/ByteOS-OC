name = gzip
version = 1.0.0-1
desc = pack and unpack .gz files: gzip, gunzip, zcat, and tar -z (opens a PC's .gz too)
depend = byteos>=1.16.0
isize = 21592
402 - /usr/bin/gunzip.lua
--[[
  gunzip - unpack .gz files (the same as gzip -d)

    gunzip FILE.gz...   FILE.gz becomes FILE (.tgz becomes .tar)
    -c -k -f -v         as for gzip: man gzip
    ... | gunzip        unpack the input into the output
]]--
local words = { "gzip", "-d" }
for _, a in ipairs(arg or {}) do words[#words + 1] = "'" .. a:gsub("'", "'\\''") .. "'" end
return shell.run(table.concat(words, " "), stdio)
4356 z /usr/bin/gzip.lua
 - /usr/bin/zcat.lua
--[[
  zcat - show what is in .gz files (the same as gzip -dc)

    zcat FILE.gz...      their unpacked contents, one after another
    zcat notes.gz | grep todo
]]--
local words = { "gzip", "-dc" }
for _, a in ipairs(arg or {}) do words[#words + 1] = "'" .. a:gsub("'", "'\\''") .. "'" end
return shell.run(table.concat(words, " "), stdio)
