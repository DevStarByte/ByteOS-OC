435 - .INSTALL
local function hint()
  if not fs.exists("/usr/bin/quickshell.lua") then
    print("Hyprbyte has no bar of its own (as Hyprland): pacman -S quickshell,")
    print("then exec-once = quickshell in ~/.config/hyprbyte.conf")
  end
end
function post_install() hint() end
function post_upgrade(new, old)
  if tostring(old):match("^1%.[012]%.") then print("Hyprbyte 1.3: the built-in bar is gone; quickshell draws one now") end
  hint()
end
889 - /etc/hyprbyte.conf
# /etc/hyprbyte.conf - Hyprbyte's settings for everyone.
# Your own go into ~/.config/hyprbyte.conf (same format) and win.

# the key for every shortcut: alt, super (the Windows key) or ctrl
mod = alt

# space around the windows and between them (default: 1 on wide screens)
# gaps_out = 1
# gaps_in = 1

# windows pop open
animations = yes
# rounded corners on the frames
rounding = yes
# There is no bar of its own, as in Hyprland: quickshell draws one
# (exec-once = quickshell, below).

# programs to open in windows at the start, one per line (default: a terminal)
# open = btop

# programs to run in the background at the start, without a window (as in
# Hyprland), e.g. a panel; what they print goes to the system log
# exec-once = quickshell

# your own keys (MOD is the mod key above), as in hyprland.conf:
# bind = MOD, B, exec, btop
# bind = MOD SHIFT, R, spawn, rofi -show run
