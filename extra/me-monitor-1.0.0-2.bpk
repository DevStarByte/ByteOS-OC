# me-monitor: items to keep an eye on (sudo systemctl enable --now me-monitor)
#
#   minimum LABEL COUNT     LABEL as shown in game, or the item's id
#                           (minecraft:iron_ingot)
#   interval = SECONDS      how often the service checks (default 60)
#
# minimum Iron Ingot 256
# minimum minecraft:redstone 1000
interval = 60
