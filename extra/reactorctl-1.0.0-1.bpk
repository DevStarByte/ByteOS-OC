function post_install()
  print("automatic control: sudo systemctl enable --now reactorctl (settings in /etc/reactorctl.conf)")
end
function post_upgrade()
  local systemd = require("systemd")
  if systemd.status("reactorctl").active == "active" then systemd.restart("reactorctl") end
end
function pre_remove()
  local systemd = require("systemd")
  systemd.stop("reactorctl")
  systemd.disable("reactorctl")
end
409 - /etc/reactorctl.conf
# reactorctl: automatic control (sudo systemctl enable --now reactorctl)
#
# The control rods go in as far (in %) as the energy buffer is full.

# stop a reactor when its buffer is fuller than this (%)
off_above = 95
# start it again when the buffer is below this (%)
on_below = 20
# how far the rods move toward their goal each step (0.05-1; 1 = at once)
smoothing = 0.5
# seconds between steps
interval = 5
4692 z /usr/bin/reactorctl.lua
 - /usr/bin/reactorctld.lua
--[[
  reactorctld - controls the reactors automatically (the reactorctl
  service; see `man reactorctl`)

  Every `interval` seconds it puts each reactor's control rods in as far
  as its energy buffer is full, stops it above off_above % and starts it
  below on_below %. What it changes goes to the system log
  (journalctl -u reactorctl). /etc/reactorctl.conf is read again when it
  changes. Actively cooled reactors (steam for turbines) are left alone.
]]--
local rc = require("reactorctl")
local cfg, gen = rc.config(), k.fs.generation()
print(("reactorctld started: rods follow the buffer, off above %d%%, on below %d%%")
  :format(cfg.off_above, cfg.on_below))
while true do
  if k.fs.generation() ~= gen then cfg, gen = rc.config(), k.fs.generation() end
  rc.step(cfg, print)
  k.event.pull(cfg.interval)
end
