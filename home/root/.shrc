# ~/.shrc - run by ByteShell at every login, after /etc/profile.
# Put your own aliases and variables here; `source ~/.shrc` reloads it.

alias ll='ls -l'
alias la='ls -a'
alias l='ls -1'
alias ..='cd ..'
alias cls=clear

# export PATH=$PATH:$HOME/bin
# GREETING=           # no greeting at login (or set your own text)
